<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.dhionson2</groupId>
    <artifactId>code-integrity-guard-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>spring-boot-authorization-example</artifactId>
  <name>Spring Boot Authorization Example</name>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.dhionson2</groupId>
      <artifactId>code-integrity-guard-testkit</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <cig.evidence.file>${project.build.directory}/cig-evidence.tsv</cig.evidence.file>
            <cig.scenario.evidence.file>${project.build.directory}/cig-scenario-evidence.tsv</cig.scenario.evidence.file>
            <cig.scenarios.file>${project.basedir}/.cig/scenarios.tsv</cig.scenarios.file>
            <cig.run.manifest.file>${project.build.directory}/cig-evidence-run.properties</cig.run.manifest.file>
          </systemPropertyVariables>
          <excludedGroups>diagnostic-vulnerable</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>io.github.dhionson2.example.CustomerController</param>
          </targetClasses>
          <targetTests>
            <param>io.github.dhionson2.example.FixedCustomerAuthorizationTest</param>
          </targetTests>
          <outputFormats>
            <param>XML</param>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
          <jvmArgs>
            <param>-Dcig.evidence.disabled=true</param>
          </jvmArgs>
          <timeoutConstant>5000</timeoutConstant>
          <timeoutFactor>2</timeoutFactor>
          <threads>1</threads>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <systemPropertyVariables>
            <cig.evidence.file>${project.build.directory}/cig-evidence.tsv</cig.evidence.file>
            <cig.scenario.evidence.file>${project.build.directory}/cig-scenario-evidence.tsv</cig.scenario.evidence.file>
            <cig.scenarios.file>${project.basedir}/.cig/scenarios.tsv</cig.scenarios.file>
            <cig.run.manifest.file>${project.build.directory}/cig-evidence-run.properties</cig.run.manifest.file>
          </systemPropertyVariables>
          <excludedGroups>diagnostic-vulnerable</excludedGroups>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.dhionson2</groupId>
        <artifactId>code-integrity-guard-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>cig-prepare-evidence</id>
            <phase>initialize</phase>
            <goals>
              <goal>prepare-evidence</goal>
            </goals>
          </execution>
          <execution>
            <id>cig-seal-evidence</id>
            <phase>verify</phase>
            <goals>
              <goal>seal-evidence</goal>
            </goals>
          </execution>
          <execution>
            <id>cig-audit</id>
            <phase>verify</phase>
            <goals>
              <goal>audit</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <runManifestFile>${project.build.directory}/cig-evidence-run.properties</runManifestFile>
          <evidenceFile>${project.build.directory}/cig-evidence.tsv</evidenceFile>
          <scenarioEvidenceFile>${project.build.directory}/cig-scenario-evidence.tsv</scenarioEvidenceFile>
          <contractsFile>${project.basedir}/.cig/contracts.tsv</contractsFile>
          <scenariosFile>${project.basedir}/.cig/scenarios.tsv</scenariosFile>
          <failOnInconclusive>true</failOnInconclusive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>pit-validation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>cig-pit-validation</id>
                <phase>process-test-classes</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.github.dhionson2</groupId>
            <artifactId>code-integrity-guard-maven-plugin</artifactId>
            <configuration>
              <requirePit>true</requirePit>
              <pitExpectedClasses>
                <pitExpectedClass>io.github.dhionson2.example.CustomerController</pitExpectedClass>
              </pitExpectedClasses>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <configuration>
              <skipPublishing>true</skipPublishing>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>io.github.dhionson2.example.CustomerController</param>
              </targetClasses>
              <targetTests>
                <param>io.github.dhionson2.example.*Test</param>
              </targetTests>
              <outputFormats>
                <param>XML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>cig-vulnerable-diagnostic</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>diagnostic-vulnerable</groups>
              <excludedGroups combine.self="override">
              </excludedGroups>
              <testFailureIgnore>true</testFailureIgnore>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups>diagnostic-vulnerable</groups>
              <excludedGroups combine.self="override">
              </excludedGroups>
              <testFailureIgnore>true</testFailureIgnore>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
